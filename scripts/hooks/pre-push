#!/bin/sh
# SPDX-License-Identifier: MIT
#
# pre-push guard — never publish USER data to a PUBLIC upstream.
#
# Why this exists: a Bridge cloned directly from a PUBLIC upstream (e.g.
# bks-lab/open-bridge) has `origin` pointing at that public repo. Onboarding
# commits identity + work/ to a user/* branch; the agent's auto-end-of-work
# cycle then pushes it — and a server-side ruleset can't stop the repo
# owner/org-admin's own push. This client-side hook is the deterministic
# backstop: it converts an accidental publish of your private branch into a
# deliberate, opt-in action — for the autopilot and the human alike.
#
# Detection is offline-first: the push target is classified into ONE of three
# states — private / public / unknown — from a built-in list + bridge-config.yaml
# push_guard.* + the `.bridge-origin` marker (is_public:true => public,
# is_public:false with a MATCHING repo: slug => private); only a still-unknown
# remote escalates to `gh repo view --json visibility`.
#
# SENSITIVE payload = a user/* destination OR pushed commits carrying USER content.
# It is ALLOWED to a CONFIRMED-PRIVATE target, BLOCKED to a CONFIRMED-PUBLIC one,
# and BLOCKED to an UNKNOWN/unverifiable one (fail-CLOSED — a re-homed origin that
# can't be proven private must not leak). A CORE-clean push (no user/* dest, no
# USER content) is ALLOWED to all three, so /promote forks + feature/* keep working.
#
# Deliberate bypass (visible, per-push):  BRIDGE_PUSH_GUARD=off git push ...
# Full rationale + remediation: rules/push-guard.md
set -u

REMOTE_NAME="${1:-}"
REMOTE_URL="${2:-}"

[ "${BRIDGE_PUSH_GUARD:-on}" = "off" ] && exit 0

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || ROOT=$(pwd)

# The classifier lives in ONE place, because scripts/user-data.py asks the same
# question (may USER data live in this clone's git?) and the two answers must
# never differ: scripts/lib/remote-class.sh. Found relative to THIS hook, not to
# the repo being pushed, so a fixture repo is classified by the real logic.
# Missing (a fork that took the hook without the lib) → unknown → fail CLOSED.
_hookdir=$(cd "$(dirname "$0")" 2>/dev/null && pwd)
if [ -f "$_hookdir/../lib/remote-class.sh" ]; then
  REMOTE_CLASS_LIB=1 . "$_hookdir/../lib/remote-class.sh"
  TARGET=$(slug_of "$REMOTE_URL")
  # ── Classify the push TARGET → private | public | unknown ─────────────────
  # This drives how a SENSITIVE payload (user/* destination, or pushed commits
  # that carry USER instance content) is handled in the ref loop below:
  #   private  → ALLOW   (your own origin; deterministic & offline)
  #   public   → BLOCK   (the 2026-06-24 user/* leak class)
  #   unknown  → BLOCK   (fail-CLOSED: a re-homed / unverifiable remote can't be
  #                       proven private, so sensitive data must not flow to it)
  # A CORE-clean push is allowed to ALL THREE — see the [ -z "$blocked" ] gate below.
  target_state=$(classify_remote "$TARGET" "$ROOT")
else
  echo "pre-push: scripts/lib/remote-class.sh missing, treating $REMOTE_URL as unknown" >&2
  target_state=unknown
fi

# A confirmed-private target is your own repo — nothing to guard, allow everything.
[ "$target_state" = private ] && exit 0

ZERO="0000000000000000000000000000000000000000"
# USER *instance* paths only — never CORE templates (_template/_schema, examples/,
# work/templates/, any _-prefixed basename, or a directory's own README.md). Every cluster-wrapper
# family is matched GENERICALLY, (identity|infra|workflow)/<any>/: a list of
# family names fell behind the tree by four (vehicles, secret-stores,
# object-stores, and root ecosystem.yaml + context-budget.user.yaml), unnoticed
# while the shipped .gitignore kept those files out of every commit.
# scripts/tests/test_push_guard_paths.py holds both regexes to the tree. The destination-branch
# rule below is the primary guard; this content net is the backstop that catches
# USER instance files smuggled onto ANY other branch name (main, feature/*, a
# renamed user branch, …) — names are not trusted, content is.
USER_PATHS='^(work/(log\.md|board\.md|inbox\.md|onboarding-state\.yaml|bridge-preview\.html|tasks/|streams/|done/|archive/|memory/|drafts/|inbox/|_learning/(proposals|postmortems|audit-history|provenance)/((accepted|rejected)/)?[^._/][^/]*$|\.gitignore$)|(identity|infra|workflow)/([^/]+/[^_]|\.gitignore$)|agents/[^_]|skills/[^/]+/(LEARNINGS\.md|references/provenance\.md)$|ecosystem(\.[^/]+)?\.yaml$|(overlays|workspaces)\.lock\.yaml$|(bridge-config|bridge-deck\.config|edges|reachability-scenarios|context-budget\.user)\.yaml$)'

# CORE companions that live INSIDE the USER_PATHS prefixes and must keep flowing
# upstream. Stripped before the match, so this list is the only thing standing
# between a legitimate /promote and a false block — keep it exact.
#
# It replaces a blanket `grep -v '/README.md$'`, which exempted EVERY README at
# any depth. That was a leak: it stripped
# infra/channels/bots/<client>/README.md (a client project) and
# identity/voiceprints/README.md (biometric, GDPR Art. 9) before the regex ever
# saw them, while the sibling .yaml in the same directory was correctly blocked.
# Only a cluster-wrapper's own TYPE-level README is a core companion; anything
# nested below it is instance content.
CORE_EXEMPT='^((agents|identity/(personas|mandants|accounts|contracts|vehicles|agent)|infra/(remotes|channels|backups|instances|utilities|transcriptions|secret-stores|object-stores)|workflow/(calendars|contexts|projects|checks|workspaces|workloads))/README\.md$|agents/(tests/|pyproject\.toml$|__init__\.py$|\.gitignore$)|ecosystem\.example\.yaml$)'

blocked=""
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${remote_ref:-}" ] && continue
  [ "$local_sha" = "$ZERO" ] && continue          # branch deletion — nothing pushed
  # Decide from where the ref LANDS (remote_ref), never the local ref: git feeds the
  # hook local_ref="HEAD" for `git push origin HEAD` and a raw sha for
  # `git push origin <sha>:refs/heads/user/x`, but remote_ref is ALWAYS the
  # fully-qualified destination. Keying on it means HEAD / detached / sha push forms
  # can't dodge the user/* rule (they did when this keyed on local_ref — leak vector).
  dest=${remote_ref#refs/heads/}
  case "$dest" in
    user/*) blocked="$blocked $dest"; continue ;;   # a USER branch never reaches a public upstream
  esac
  # Any other destination (main, feature/*, ci/*, promote-*, a renamed user branch):
  # allow it ONLY if the COMMITS being pushed carry no USER instance content. Inspect
  # the pushed commits, NOT the working tree — `git diff <sha>` against a clean tree
  # looks empty and hid the content (the other half of the leak vector).
  # WHICH commits are being pushed is the whole content net, and getting it wrong
  # fails OPEN: an empty set scans nothing and the guard waves the push through.
  # Two ways it used to be empty when it must not be.
  #
  # 1. `--not --remotes` (bare) subtracts EVERY remote-tracking ref, including the
  #    PRIVATE origin that already holds all of this instance's work. Pushing a new
  #    branch to a PUBLIC remote then computed zero commits — because the private
  #    remote has them — and a branch carrying identity/personas/ went through with
  #    exit 0 and no output. Reproduced end to end. It has to be `--remotes=<this
  #    remote>`: what matters is what THIS destination does not already have.
  #
  # 2. `$remote_sha..$local_sha` is an error when the local repo does not have
  #    $remote_sha (someone force-pushed elsewhere, or this clone never fetched it).
  #    The `||` then set the set to empty and the push sailed. Now that case falls
  #    back to the destination-scoped computation, and if THAT fails too the ref is
  #    blocked rather than allowed: a net that cannot see is not a net.
  if [ "$remote_sha" = "$ZERO" ] || ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    push_commits=$(git rev-list "$local_sha" --not --remotes="$REMOTE_NAME" 2>/dev/null) || push_commits=""
  else
    push_commits=$(git rev-list "$remote_sha..$local_sha" 2>/dev/null) || push_commits=""
  fi
  # An EMPTY set scans nothing, so it must be empty for a reason. It legitimately
  # is when the destination already has every commit. It is NOT when the local
  # commit exists and we still could not enumerate: then the net is blind, and a
  # blind net has to block. (A local_sha git does not have is no real push — git
  # computes it from your own refs — so that case is left alone rather than
  # blocking every harness that fakes one.)
  if [ -z "$push_commits" ] && git cat-file -e "${local_sha}^{commit}" 2>/dev/null; then
    if ! git rev-list "$local_sha" --not --remotes="$REMOTE_NAME" >/dev/null 2>&1; then
      blocked="$blocked ${dest}(commit-set-unreadable)"
      continue
    fi
  fi
  changed=$(printf '%s\n' "$push_commits" | sed '/^$/d' \
            | git -c core.quotepath=false diff-tree -r --no-commit-id --name-only --root --stdin 2>/dev/null \
            | grep -Ev "$CORE_EXEMPT") || changed=""
  # `grep -q` exits on the FIRST match and closes the pipe, so printf takes an
  # EPIPE and dash (the /bin/sh of every Ubuntu runner) prints
  # "printf: I/O error" to stderr on every single hit. The verdict was always
  # right, the noise only made the guard look broken in CI logs (06.09.2026).
  # Without -q, grep consumes all input and nothing gets a SIGPIPE.
  if [ -n "$changed" ] && printf '%s\n' "$changed" | grep -E "$USER_PATHS" >/dev/null 2>&1; then
    blocked="$blocked ${dest}(USER-content)"
  fi
done

# CORE-clean push (no user/* dest, no USER content) → allowed to ANY target.
[ -z "$blocked" ] && exit 0

if [ "$target_state" = public ]; then
  cat >&2 <<EOF

  ✋ Push blocked — public-upstream guard (rules/push-guard.md)

     remote   $REMOTE_NAME → $TARGET   ← PUBLIC upstream
     refs    $blocked

  USER-branch content (identity/agent, work/, client data) must never land on a
  public repo. The sanctioned path to a public upstream is a fork-based PR via
  /promote — never a direct push of your branch.

  Fix (recommended) — re-home this clone to a PRIVATE origin:
     git remote rename origin upstream
     gh repo create <you>/my-bridge --private --source=. --remote=origin --push
  open-bridge then stays a read-only pull/PR upstream you /promote into.

  Just evaluating? Keep user/* local — don't push at all.
  Intentional CORE-maintainer push? Override deliberately:
     BRIDGE_PUSH_GUARD=off git push ...

EOF
else
  cat >&2 <<EOF

  ✋ Push blocked — unverified remote, USER data withheld (rules/push-guard.md)

     remote   $REMOTE_NAME → $TARGET   ← NOT confirmed private (offline / unknown)
     refs    $blocked

  This push carries USER data (a user/* branch or USER instance content) to a
  remote I can't confirm is private — gh is offline/unavailable or the repo's
  visibility is unknown. To prevent an accidental public leak, USER data is held
  back until the remote is known to be yours.

  Fix — tell the guard this remote is private (pick one), then re-push:
     • bridge-config.yaml →  push_guard:
                               private_remotes: [$TARGET]
     • or .bridge-origin  →  repo: $TARGET
                             is_public: false

  CORE-only pushes (no user/* branch, no USER content) are NOT affected — they
  flow to any remote. Deliberate one-off override (visible, per-push):
     BRIDGE_PUSH_GUARD=off git push ...

EOF
fi
exit 1
