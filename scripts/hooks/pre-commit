#!/bin/sh
# SPDX-License-Identifier: MIT
# open-bridge pre-commit — task-sync + continuous-logging reminder (WARN-only).
#
# The tool-agnostic backstop for the "Consult before write" gate + continuous
# logging: fires for ANY tool that shells out to `git commit` (Claude Code,
# GitHub Copilot CLI, Codex, Gemini CLI, Cursor) — because every one of them
# commits through git. Mirrors scripts/hooks/pre-push arming:
#     git config core.hooksPath scripts/hooks
#
# Philosophy: WARN, never block. Always exits 0 (unlike pre-push, which blocks
# because it is a leak guard). Skip deliberately with `git commit --no-verify`.
# Every gate prints to stderr, which the calling agent receives in-band in the
# git tool result — re-anchoring the rule at the one seam a long, escalating
# session cannot skip.

set +e
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$ROOT" 2>/dev/null || exit 0

# ─────────────────────────────────────────────────────────────────────────────
# HARD GATE — a staged `.env` is refused. BLOCKS, and runs on EVERY branch.
#
# Everything below this block is warn-only and instance-only (`user/*` + work/).
# This one is different for the same reason pre-push is: it is a leak guard, not
# a reminder. It sits ABOVE the branch gate deliberately — otherwise a `.env`
# staged on `main` would exit 0 before any check ran.
#
# `.gitignore` already excludes `.env` at every depth and none has ever been
# committed here, but `.gitignore` is advisory: `git add -f` walks straight past
# it. This is the layer that does not depend on anyone remembering.
#
# Carve-out: `.env.template` / `.env.example` are documentation and must stay
# committable — but only while their values are EMPTY. A template someone filled
# in for a quick test is a secrets file wearing a template's name, so the
# exemption tests the CONTENT, not the filename. Put example values in a comment
# above the key, never to the right of the `=`.
# ─────────────────────────────────────────────────────────────────────────────
env_blocked=""
# No temp file: a sandboxed agent session may not write to /tmp, and a failed
# redirect there silently skipped this whole check.
env_staged=$(git diff --cached --name-only -z 2>/dev/null |
  tr '\0' '\n' |
  grep -E '(^|/)\.env($|\.)')
while IFS= read -r f; do
  [ -n "$f" ] || continue
  case "${f##*/}" in
    .env.template|.env.example)
      # non-empty value to the right of `=` ⇒ not a template any more
      if git show ":$f" 2>/dev/null |
         grep -qE '^[A-Za-z_][A-Za-z0-9_]*=[[:space:]]*[^[:space:]"'"'"']'; then
        env_blocked="$env_blocked
$f (Template mit ausgefülltem Wert)"
      fi
      ;;
    *)
      env_blocked="$env_blocked
$f"
      ;;
  esac
done <<ENVSTAGED
$env_staged
ENVSTAGED

if [ -n "$env_blocked" ]; then
  printf '%s\n' "── bridge pre-commit · BLOCKIERT ──────────────────────────────────" >&2
  printf '%s\n' "✗ .env darf nie committet werden. Staged:" >&2
  printf '%s\n' "$env_blocked" | sed '/^$/d; s/^/    /' >&2
  printf '%s\n' "" >&2
  printf '%s\n' "  Diese Dateien tragen Zugangsdaten. .gitignore schließt sie aus," >&2
  printf '%s\n' "  aber \`git add -f\` geht daran vorbei — deshalb dieser Hook." >&2
  printf '%s\n' "" >&2
  printf '%s\n' "  Aus dem Index nehmen:  git restore --staged <datei>" >&2
  printf '%s\n' "  Erlaubt sind nur .env.template / .env.example mit LEEREN Werten" >&2
  printf '%s\n' "  (Beispielwerte in den Kommentar über den Key, nie hinter das \`=\`)." >&2
  printf '%s\n' "───────────────────────────────────────────────────────────────────" >&2
  exit 1
fi

# ─────────────────────────────────────────────────────────────────────────────
# HARD GATE: a credential in a staged instance file is refused. BLOCKS, on
# EVERY branch, for the same reason as the .env gate above.
#
# A private instance commits its own config (scripts/user-data.py: nothing is
# ignored on a private origin), so the backup must never become the leak. The
# scan reads the INDEX, i.e. what this commit will contain, of every instance
# file and its templates, and reports at most eight characters of a hit.
# Personal data is not a credential and passes: a persona carries a tax id by
# design. Found relative to THIS hook, so any repo it is armed in is scanned by
# the same code.
# ─────────────────────────────────────────────────────────────────────────────
_ud="$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)/user-data.py"
# A python that can actually run, probed: python.org on Windows ships no
# python3.exe, and the Store alias `python3` exits 9009 instead of running.
_py=""
for _cand in python3 python "py -3"; do
  if $_cand -c 'import sys' >/dev/null 2>&1; then _py=$_cand; break; fi
done
if [ -f "$_ud" ]; then
  if [ -z "$_py" ]; then
    printf '%s\n' "⚠ pre-commit: no python found, staged instance files were NOT scanned for credentials" >&2
  else
    _scan=$($_py "$_ud" scan-staged 2>&1)
    _rc=$?
    case $_rc in
      0) : ;;
      3) printf '%s\n' "⚠ $_scan" >&2 ;;
      *)
        # 1 = a credential, 2 = unreadable content, anything else = the scan
        # itself failed. All of them refuse: a scan that did not finish is not a pass.
        printf '%s\n' "── bridge pre-commit · BLOCKIERT ──────────────────────────────────" >&2
        [ -n "$_scan" ] && printf '%s\n' "$_scan" >&2
        [ "$_rc" -gt 2 ] && printf '%s\n' "  (secret scan failed with exit $_rc)" >&2
        printf '%s\n' "  Aus dem Index nehmen:  git restore --staged <datei>" >&2
        printf '%s\n' "───────────────────────────────────────────────────────────────────" >&2
        exit 1
        ;;
    esac
  fi
fi

# Instance-only: run on user/* branches with a work/ tree. No-op on CORE
# branches (main/development) and repos without a work-system.
BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
case "$BRANCH" in
  user/*) : ;;
  *)      exit 0 ;;
esac
[ -d work ] || exit 0

STAGED=$(git diff --cached --name-only 2>/dev/null)
[ -n "$STAGED" ] || exit 0

# (g) BACKUP gate: instance data this clone ignores although its origin is
# private. The failure is silent by nature: a file that is ignored is never
# staged, so no other gate ever sees it. Asked on every instance commit, because
# the file that matters is the one NOT in it.
if [ -f "$_ud" ] && [ -n "$_py" ]; then
  _gap=$($_py "$_ud" check 2>&1) ||
    { printf '%s\n' "⚠ BACKUP (warn-only):" >&2; printf '%s\n' "$_gap" | sed 's/^/  /' >&2; }
fi

# Productive change? (else stay silent — routine/Class-C commit)
echo "$STAGED" | grep -Eq '^(skills|protocols|identity|infra|workflow|rules|docs|scripts)/|^work/(tasks|streams)/|\.(py|js|ts|sh|md|ya?ml)$' || exit 0

TODAY=$(date +%F)
warn() { printf '%s\n' "$*" >&2; }

warn "── bridge pre-commit · warn-only · --no-verify to skip ─────────────"

# (a) LOG gate — per-event + touch-proof: count today's DATED rows, not mtime.
# Count only THIS branch's own work units, or the gate can never be satisfied:
#   --first-parent  commits merged in from an upstream are someone else's work,
#                   not units this repo has to log
#   --no-merges     the merge commit itself is bookkeeping, not a work unit
#   grep -v log:    a `log:` commit exists to persist the row itself, so counting
#                   it double-counts every logged unit (row + commit-to-save-row)
commits_today=$(git log --since="$TODAY 00:00" --first-parent --no-merges \
  --format='%s' 2>/dev/null | grep -cvE '^(log|chore\(log\)|docs\(log\)):')
commits_today=${commits_today:-0}
rows_today=$(grep -c "^| $TODAY " work/log.md 2>/dev/null || true)
rows_today=${rows_today:-0}
if [ "${rows_today:-0}" -le "${commits_today:-0}" ]; then
  warn "⚠ LOG: $rows_today dated row(s) vs $commits_today own work commit(s) today — this unit likely has no work/log.md row."
  warn "  append →  | $TODAY $(date +%H:%M) | <glyph> | <context> | <what + why> |"
fi

# (b) ACTIVE-TASK re-anchor — surface existing homes before a duplicate is born.
tasks=$(find work/tasks -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')
streams=$(find work/streams -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')
warn "→ ACTIVE-TASK: $tasks task dir(s), $streams stream(s). Does this commit belong to an existing one?"
warn "  streams: $(ls work/streams 2>/dev/null | tr '\n' ' ')"
warn "  If it grew out of a read-only query, re-run the four-step gate (rules/task-management-workflow.md)."

# (c) WIP gate — re-checked every commit, not only at session start.
# work.max_active, 10 when it is not set, 0 = no cap and no warning (gen-board.py reads it the same way).
max=$(grep -E '^[[:space:]]*max_active:' bridge-config.yaml 2>/dev/null | grep -oE '[0-9]+' | head -1)
max=${max:-10}
[ "$max" = 0 ] && max=
active=$(grep -lE '^status:[[:space:]]*(doing|review)' work/tasks/*/STATUS.md 2>/dev/null | wc -l | tr -d ' ')
if [ -n "$max" ] && [ "${active:-0}" -gt "$max" ]; then
  warn "⚠ WIP: $active doing+review > max_active $max — close, reprioritise, or move a long-runner to work/streams/."
fi

# (d) STATUS-enum gate — only if the validator exists (FIX 6).
if [ -x scripts/validate-status.py ]; then
  echo "$STAGED" | grep -q 'work/.*/STATUS.md' && scripts/validate-status.py --staged 2>&1 | sed 's/^/  /' >&2
fi

# (e) BOARD-drift gate — only if gen-board supports a check mode.
if echo "$STAGED" | grep -Eq '^work/(tasks|streams|done)/' && [ -f scripts/gen-board.py ]; then
  python3 scripts/gen-board.py --check >/dev/null 2>&1 || warn "⚠ BOARD: work/ changed — regenerate with python3 scripts/gen-board.py"
fi

# ─────────────────────────────────────────────────────────────────────────────
# (f) ALWAYS-ON gate — the four context guards, on the one branch CI never sees.
#
# `validate.yml` triggers on `main` only. Every instance works on `user/*`, so
# in a downstream tree these guards run when somebody types the command and
# never otherwise. That is the difference between having a guard and running
# one, and it went unnoticed here until an audit went looking: a whole family of
# checks, green in upstream CI, unenforced in every tree they were written for.
#
# Warn-only like everything else in this file, and gated on the surface being
# touched, so an ordinary work commit pays nothing. Measured on a live instance:
# 2.6 s for all four when they do run.
SURFACE='^(context-budget.*\.yaml|ecosystem.*\.yaml|CLAUDE\.md|AGENTS\.md|identity/|infra/|workflow/|protocols/standing-orders/|skills/|\.claude/agents/)'
if echo "$STAGED" | grep -Eq "$SURFACE"; then
  # Each is skipped when absent: a fork that has not adopted one is not failing
  # a check about a file it never took.
  [ -f scripts/measure-context.py ] && python3 scripts/measure-context.py >/dev/null 2>&1 ||
    { [ -f scripts/measure-context.py ] && warn "⚠ BUDGET: an always-on item is over cap or undeclared — python3 scripts/measure-context.py"; }
  [ -f scripts/context-index.py ] && python3 scripts/context-index.py --check >/dev/null 2>&1 ||
    { [ -f scripts/context-index.py ] && warn "⚠ INDEX: a declared card no longer matches its source — python3 scripts/context-index.py --check"; }
  [ -f scripts/check-reachability.py ] && python3 scripts/check-reachability.py >/dev/null 2>&1 ||
    { [ -f scripts/check-reachability.py ] && warn "⚠ REACH: a config family is named in nothing a session loads — python3 scripts/check-reachability.py"; }
  [ -f scripts/check-edges.py ] && python3 scripts/check-edges.py >/dev/null 2>&1 ||
    { [ -f scripts/check-edges.py ] && warn "⚠ EDGES: a reference between entries no longer resolves — python3 scripts/check-edges.py"; }
  [ -f scripts/standing-orders.py ] && python3 scripts/standing-orders.py --check >/dev/null 2>&1 ||
    { [ -f scripts/standing-orders.py ] && warn "⚠ ORDERS: a standing order is unreadable or defers with no trigger — python3 scripts/standing-orders.py --check"; }
fi

# ─────────────────────────────────────────────────────────────────────────────
# (h) WORKLOAD-declaration gate: a declared run held against its contract.
#
# Same insight as (f) above: no workflow runs inside an instance, so the
# commit seam is the only automatic gate a declaration meets.
#
# WHY IT IS HERE AND NOT ONLY IN CI: every workflow in this repository triggers
# on `main` only, and instance work happens on `user/*`. A declaration that
# drifts from the schema would therefore meet no gate at all until somebody
# typed `workload validate` by hand. Live declarations had exactly that status
# before this gate existed.
#
# WARN and not block, deliberately: a broken declaration does not reach a
# machine from here. `provision.plan` asks the hand-written gate before it
# writes anything, and that gate refuses. This check exists to find the break
# EARLY, at the seam a long session cannot skip, not to prevent damage.
#
# Costs 323 ms measured, and only when a declaration is actually staged.
if echo "$STAGED" | grep -Eq '^workflow/workloads/[^_/]+\.yaml$' && [ -f scripts/validate-bridge.py ]; then
  if ! python3 scripts/validate-bridge.py --check --surface workload >/dev/null 2>&1; then
    warn "⚠ WORKLOAD: a declaration does not match workflow/workloads/_schema.yaml."
    warn "  see →  python3 scripts/validate-bridge.py --surface workload"
  fi
fi

# ─────────────────────────────────────────────────────────────────────────────
# (i) COCKPIT gate: the two cockpit checks that catch what a local tree hides.
#
# A view that imports a file missing from the CORE allowlist
# (scripts/categorize-commits.py) loads fine here and breaks the page in every
# tree that receives only CORE; the demo copy (docs/cockpit-demo/) drifts the
# moment scripts/web changes. Both are green in upstream CI and nowhere else,
# for the reason (f) gives. Warn only, gated on the cockpit being staged:
# about 2 s when it runs. The bare `pytest` binary, because on some machines
# python3 has no pytest module while `pytest` runs under one that does.
if echo "$STAGED" | grep -Eq '^scripts/(web|lib/bridge_cockpit)/|^scripts/categorize-commits\.py$'; then
  PYTEST=$(command -v pytest || true)
  if [ -n "$PYTEST" ] && [ -f scripts/tests/test_bridge_cockpit_core.py ]; then
    "$PYTEST" -q scripts/tests/test_bridge_cockpit_core.py >/dev/null 2>&1 ||
      warn "⚠ COCKPIT: a dashboard file is outside the CORE allowlist: pytest -q scripts/tests/test_bridge_cockpit_core.py"
  fi
  [ -f scripts/build-cockpit-demo.py ] && { python3 scripts/build-cockpit-demo.py --check >/dev/null 2>&1 ||
    warn "⚠ COCKPIT: docs/cockpit-demo/ drifted from scripts/web: python3 scripts/build-cockpit-demo.py --write"; }
fi

warn "───────────────────────────────────────────────────────────────────"
exit 0
