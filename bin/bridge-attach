#!/bin/sh
# SPDX-License-Identifier: MIT
# Start an agent in the current repo with this Bridge attached.
#   <bridge>/bin/bridge-attach claude [claude args...]
#   <bridge>/bin/bridge-attach codex  [codex args...]
#   <bridge>/bin/bridge-attach copilot [copilot args...]
#   <bridge>/bin/bridge-attach plan claude      # show what would run
# Docs: docs/bridge-attach.md
set -eu
root=$(cd "$(dirname "$0")/.." && pwd -P)
if [ "$#" -eq 0 ]; then
  echo "usage: bridge-attach claude|codex|copilot [args...]   or   bridge-attach plan <tool>" >&2
  exit 2
fi
if [ "$1" = "plan" ]; then
  shift
  tool=${1:?tool}; shift
  exec python3 "$root/scripts/bridge-attach.py" plan "$tool" --root "$root" --cwd "$PWD" -- "$@"
fi
tool=$1; shift
exec python3 "$root/scripts/bridge-attach.py" exec "$tool" --root "$root" --cwd "$PWD" -- "$@"
