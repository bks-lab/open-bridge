"""Launch Codex CLI with shared Bridge process-boundary checks."""
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'scripts/lib'))
from cli_launcher import entrypoint

if __name__ == '__main__':
    sys.exit(entrypoint('codex', ROOT))
