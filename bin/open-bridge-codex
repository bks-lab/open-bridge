#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Open Bridge Codex: launch Codex CLI with Bridge's process-boundary checks."""
import argparse
import os
from pathlib import Path
import shutil
import subprocess
import sys
import uuid


def main():
    parser = argparse.ArgumentParser(description=__doc__, add_help=True)
    parser.add_argument('--check', action='store_true', help='Check this checkout without launching Codex')
    parser.add_argument('--exec', dest='noninteractive', action='store_true', help='Run codex exec instead of the interactive CLI')
    args, forwarded = parser.parse_known_args()
    if forwarded[:1] == ['--']:
        forwarded = forwarded[1:]
    if any(value in ('-C', '--cd', '--worktree', '--remote') or
           value.startswith(('--cd=', '--remote=')) or value.startswith('-C')
           for value in forwarded):
        parser.error('cwd/worktree/remote overrides are not supported: checks must cover the launched checkout')
    root = Path(__file__).resolve().parents[1]
    adapter = root / 'scripts/codex-bridge.py'
    try:
        import yaml  # noqa: F401 — shared Bridge scripts require PyYAML
    except ImportError:
        print('PyYAML is required. Install Bridge dependencies in your Python environment.', file=sys.stderr)
        return 1
    codex = shutil.which('codex')
    if not codex:
        print('Codex CLI is not on PATH. Install it and authenticate before launching.', file=sys.stderr)
        return 1
    def bridge(command, *extra):
        return subprocess.run([sys.executable, str(adapter), command, '--root', str(root), *extra], cwd=root).returncode
    if args.check:
        return bridge('doctor')
    # Keep an existing custom hook installation intact; never silently replace it.
    hooks = subprocess.run(['git', '-C', str(root), 'config', '--get', 'core.hooksPath'], capture_output=True, text=True)
    if hooks.returncode not in (0, 1):
        print('Cannot read Git hook configuration.', file=sys.stderr)
        return 1
    if hooks.stdout.strip() not in ('', 'scripts/hooks'):
        print('Custom core.hooksPath detected. Integrate Bridge push protection before using this launcher; existing hooks were preserved.', file=sys.stderr)
        return 1
    subprocess.run(['git', '-C', str(root), 'config', 'core.hooksPath', 'scripts/hooks'], check=True)
    token = 'cli-' + uuid.uuid4().hex
    if bridge('checkpoint', '--session-id', token):
        return 1
    command = [codex]
    if args.noninteractive:
        command.append('exec')
    command.extend(['-C', str(root)])
    command.extend(forwarded or ['Follow AGENTS.md and docs/codex.md. Run the Bridge session-start flow, then show the next appropriate action.'])
    code = 1
    try:
        code = subprocess.run(command, cwd=root).returncode
    except KeyboardInterrupt:
        code = 130
    finally:
        checked = bridge('finish', '--session-id', token)
        if checked:
            print(f'Bridge completion check failed; checkpoint retained: {token}', file=sys.stderr)
    if code < 0:
        code = 128 - code
    return code if code else checked


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, subprocess.CalledProcessError) as error:
        print(f'Open Bridge Codex: {error}', file=sys.stderr)
        sys.exit(1)
