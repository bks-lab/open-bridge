#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Bridge — post-clone setup
#
# Ensures every supported AI agent can auto-discover the repo's skills by
# exposing the canonical top-level `skills/` folder at three discovery paths:
#   .claude/skills   (Claude Code)
#   .agents/skills   (Codex / Gemini CLI / Copilot CLI / Cursor)
#   .github/skills   (GitHub Copilot)
# All three ship as committed symlinks to `../skills`; this script repairs any
# that a checkout materialized as a plain file (e.g. native Windows git).
#
# It also arms the git hooks, checks PyYAML, and warns (never fails) when
# Claude Code is too old to load AGENTS.md or a CLAUDE.md in a parent folder
# would make Claude Code load that file instead of AGENTS.md.
#
# macOS / Linux / WSL: works out of the box.
# Native Windows: see `bin/setup.ps1` instead (handles symlink quirks).

set -e

cd "$(dirname "$0")/.."

link_skills() {
    local target="$1"            # e.g. .claude/skills
    local parent="${target%/*}"  # e.g. .claude
    local source="../skills"

    if [ -L "$target" ] && [ -d "$target" ]; then
        echo "OK  $target is a working symlink"
        return 0
    fi
    if [ -d "$target" ] && [ ! -L "$target" ]; then
        echo "ERR $target exists as a real directory — manual review needed"
        echo "    (expected: symlink to $source)"
        return 1
    fi
    if [ -e "$target" ] || [ -L "$target" ]; then
        echo "INFO Removing broken $target (likely Windows-git symlink-as-textfile)"
        rm -f "$target"
    fi
    mkdir -p "$parent"
    ln -s "$source" "$target"
    echo "OK  Created $target -> $source"
}

rc=0
for t in .claude/skills .agents/skills .github/skills; do
    link_skills "$t" || rc=1
done

if [ -d ".claude/skills/bridge-onboard" ]; then
    echo "OK  Skill discovery verified (.claude/skills/bridge-onboard/ resolves)"
else
    echo "WARN Symlinks created but skills not visible — check that skills/ exists at repo root"
    rc=1
fi

# Arm the git hooks (rules/push-guard.md + the task-sync/logging backstop): route
# git hooks to the tracked dir. One setting wires BOTH scripts/hooks/pre-push (blocks
# publishing a user/* branch to a public upstream) AND scripts/hooks/pre-commit (the
# task-sync + continuous-logging reminder), for every tool that shells out to git.
# This `git config core.hooksPath` is THE single deterministic arming action — session
# start (Phase 0, rules/session-start.md) runs it unconditionally, and every non-Claude
# tool (Codex/Copilot/Gemini) is told to run `bin/setup` before its first commit.
# A hook that isn't on core.hooksPath is present but NOT wired.
# NOTE: do NOT `pre-commit install` — the pre-commit framework refuses when
# core.hooksPath is set; .pre-commit-config.yaml is for CI / manual runs only.
if [ -d "scripts/hooks" ]; then
    git config core.hooksPath scripts/hooks
    chmod +x scripts/hooks/* 2>/dev/null || true
    echo "OK  Git hooks armed (core.hooksPath -> scripts/hooks): pre-push guard + pre-commit task/log reminder"
else
    echo "WARN scripts/hooks/ missing — git hooks not armed"
fi

# Instance data follows the origin (scripts/user-data.py). The shipped .gitignore
# keeps it out of every clone; a PRIVATE origin gets identity/ infra/ workflow/
# work/.gitignore negations (committed with the instance) and its root files
# staged once, so everything is backed up. Re-run on every session start, so
# re-homing origin to a private repo takes effect without anyone editing a list.
if [ -f "scripts/user-data.py" ] && command -v python3 >/dev/null 2>&1; then
    python3 scripts/user-data.py arm || { echo "WARN user-data arm failed, instance data may be not backed up"; rc=1; }
else
    echo "WARN python3 missing, instance data is not backed up (scripts/user-data.py)"
    rc=1
fi

# PyYAML is a hard requirement: the Bridge's own scripts read YAML from the first
# session on (bridge-config.py, context-index.py, validate-bridge.py), and the
# system Python on macOS ships without it. Check and explain, never install:
# which install path is right depends on how this Python was installed.
if command -v python3 >/dev/null 2>&1; then
    if python3 -c "import yaml" >/dev/null 2>&1; then
        echo "OK  PyYAML importable"
    else
        echo "ERR PyYAML missing for $(command -v python3); the Bridge's scripts cannot read their YAML."
        echo "    Install it with one of these, then re-run bin/setup:"
        echo "      python3 -m pip install --user pyyaml"
        echo "      sudo apt install python3-yaml                                 # Debian / Ubuntu"
        echo "      python3 -m pip install --user --break-system-packages pyyaml  # Homebrew Python"
        rc=1
    fi
fi

# Claude Code loads AGENTS.md as this repo's entry file from 2.1.277 on
# (2.1.281 on Bedrock, Vertex, Foundry and gateways). This repo ships no
# CLAUDE.md, so an older Claude Code starts with no instructions at all.
# Warn only: Claude Code is one of several supported tools.
CLAUDE_MIN="2.1.281"
version_lt() {  # true when $1 < $2, field by field as numbers
    local IFS=.
    local -a a=($1) b=($2)
    local i
    for i in 0 1 2; do
        if (( 10#${a[i]:-0} < 10#${b[i]:-0} )); then return 0; fi
        if (( 10#${a[i]:-0} > 10#${b[i]:-0} )); then return 1; fi
    done
    return 1
}
if command -v claude >/dev/null 2>&1; then
    cv=$(claude --version 2>/dev/null | head -n 1 | sed -n 's/^[^0-9]*\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' || true)
    if [ -z "$cv" ]; then
        echo "WARN Could not read the Claude Code version; it needs $CLAUDE_MIN or newer to load AGENTS.md"
    elif version_lt "$cv" "$CLAUDE_MIN"; then
        echo "WARN Claude Code $cv is older than $CLAUDE_MIN and will not load AGENTS.md here. Update: claude update"
    else
        echo "OK  Claude Code $cv supports AGENTS.md (default option)"
    fi
fi

# A CLAUDE.md or CLAUDE.local.md in any parent folder makes Claude Code load
# that file and skip AGENTS.md, on every version. Warn only.
dir=$(cd .. && pwd)
while :; do
    for f in CLAUDE.md CLAUDE.local.md; do
        if [ -f "${dir%/}/$f" ]; then
            echo "WARN ${dir%/}/$f sits in a parent folder: Claude Code will not load AGENTS.md here"
        fi
    done
    if [ "$dir" = "/" ]; then break; fi
    dir=$(dirname "$dir")
done

# Optional: the tool-agnostic gh wrapper (scripts/bin/gh) reminds you to log remote
# issue/PR/board ops. Not auto-written into your shell profile — opt in by adding it
# to PATH yourself:
if [ -x "scripts/bin/gh" ]; then
    echo "TIP gh log-reminder available — enable by adding to your shell profile:"
    echo "      export PATH=\"$(pwd)/scripts/bin:\$PATH\""
fi

exit "$rc"
